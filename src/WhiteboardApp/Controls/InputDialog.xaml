<Window x:Class="WhiteboardApp.Controls.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="이름 바꾸기" Width="360" SizeToContent="Height"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FF20232B">
    <Window.Resources>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="#FF2A2E37"/>
            <Setter Property="Foreground" Value="#FFE8E9ED"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter Margin="8,6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" Foreground="#FFB8BCC8" FontSize="12" Margin="0,0,0,6"/>
        <TextBox x:Name="InputBox" FontSize="14" Padding="6,5"
                 Background="#FF2A2E37" Foreground="#FFE8E9ED" CaretBrush="#FFE8E9ED"
                 BorderBrush="#FF3A3E48"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="취소" Width="70" Margin="0,0,8,0" IsCancel="True" Style="{StaticResource FlatButton}"/>
            <Button Content="확인" Width="70" IsDefault="True" Click="Ok_Click" Background="#FF4C9AFF" Style="{StaticResource FlatButton}"/>
        </StackPanel>
    </StackPanel>
</Window>
