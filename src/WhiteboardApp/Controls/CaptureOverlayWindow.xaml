<Window x:Class="WhiteboardApp.Controls.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#01000000"
        Cursor="Cross"
        KeyDown="Window_KeyDown">
    <Canvas x:Name="RootCanvas"
            MouseLeftButtonDown="RootCanvas_MouseLeftButtonDown"
            MouseMove="RootCanvas_MouseMove"
            MouseLeftButtonUp="RootCanvas_MouseLeftButtonUp">
        <Rectangle x:Name="DimOverlay" Fill="#55000000" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}}"/>
        <Rectangle x:Name="SelectionRect" Stroke="#FF00A8FF" StrokeThickness="2" Fill="#3300A8FF" Visibility="Collapsed"/>
        <TextBlock x:Name="HintText" Foreground="White" FontSize="16" Text="드래그하여 캡처할 영역을 선택하세요 (Esc: 취소)"
                   Canvas.Left="20" Canvas.Top="20"/>
    </Canvas>
</Window>
