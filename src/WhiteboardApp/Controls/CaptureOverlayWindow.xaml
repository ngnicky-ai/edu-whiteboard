<Window x:Class="WhiteboardApp.Controls.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#01000000"
        Cursor="Cross"
        KeyDown="Window_KeyDown">
    <!-- Near-transparent background keeps the whole screen clickable, including inside the selection "hole". -->
    <Canvas x:Name="RootCanvas" Background="#01000000"
            MouseLeftButtonDown="RootCanvas_MouseLeftButtonDown"
            MouseMove="RootCanvas_MouseMove"
            MouseLeftButtonUp="RootCanvas_MouseLeftButtonUp">
        <!-- Dims everything except the selected area (geometry set in code), so the selection shows its real colors. -->
        <Path x:Name="DimOverlay" Fill="#66000000" IsHitTestVisible="False"/>
        <Rectangle x:Name="SelectionRect" Stroke="#FF4C9AFF" StrokeThickness="2" Fill="{x:Null}"
                   Visibility="Collapsed" IsHitTestVisible="False"/>
        <Border x:Name="HintBox" Canvas.Left="20" Canvas.Top="20" Background="#CC20232B" CornerRadius="6" Padding="12,6" IsHitTestVisible="False">
            <TextBlock Foreground="White" FontSize="15" Text="드래그하여 캡처할 영역을 선택하세요 (Esc: 취소)"/>
        </Border>
    </Canvas>
</Window>
