<Window x:Class="WhiteboardApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="교육용 판서 프로그램" Height="800" Width="1480" MinWidth="900"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        Background="#FF15161B"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">
    <Window.InputBindings>
        <KeyBinding Key="V" Modifiers="Control" Command="Paste"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="Undo"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="Redo"/>
        <KeyBinding Key="S" Modifiers="Control" Command="Save"/>
        <KeyBinding Key="O" Modifiers="Control" Command="Open"/>
        <KeyBinding Key="Delete" Command="Delete"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="Paste" Executed="Paste_Executed"/>
        <CommandBinding Command="Undo" Executed="Undo_Executed"/>
        <CommandBinding Command="Redo" Executed="Redo_Executed"/>
        <CommandBinding Command="Save" Executed="Save_Executed"/>
        <CommandBinding Command="Open" Executed="Open_Executed"/>
        <CommandBinding Command="Delete" Executed="DeleteSelected_Executed"/>
    </Window.CommandBindings>

    <Window.Resources>
        <!-- Palette -->
        <SolidColorBrush x:Key="AccentBrush" Color="#FF4C9AFF"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF3D82E0"/>
        <SolidColorBrush x:Key="ToolbarBrush" Color="#FF20232B"/>
        <SolidColorBrush x:Key="ToolbarBorderBrush" Color="#FF2E323C"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#FF2D313B"/>
        <SolidColorBrush x:Key="PressedBrush" Color="#FF383D49"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFE8E9ED"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#FF8B90A0"/>
        <SolidColorBrush x:Key="FieldBrush" Color="#FF2A2E37"/>
        <SolidColorBrush x:Key="FieldBorderBrush" Color="#FF3A3E48"/>

        <!-- Vertical section divider -->
        <Style x:Key="SectionDivider" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Background" Value="{StaticResource ToolbarBorderBrush}"/>
            <Setter Property="Margin" Value="7,8"/>
        </Style>

        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <!-- Flat toolbar button -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent-filled primary button (screen capture) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tool selection toggle (pen / highlighter / eraser / select) -->
        <Style x:Key="ToolToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small icon-only button (undo/redo) -->
        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <!-- Circular color swatch -->
        <Style x:Key="ColorSwatchStyle" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Margin="2">
                            <Ellipse Stroke="#FF4A4F5C" StrokeThickness="1" Fill="{TemplateBinding Background}"/>
                            <Ellipse x:Name="HoverRing" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Margin="-3" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverRing" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider -->
        <Style x:Key="ToolbarSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" Background="{StaticResource FieldBrush}" CornerRadius="2"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{StaticResource AccentBrush}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="14" Height="14" Fill="White" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Width" Value="110"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleBtn"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Focusable="False" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ToggleButton.Background>
                                    <Binding Path="Background" RelativeSource="{RelativeSource TemplatedParent}"/>
                                </ToggleButton.Background>
                                <ToggleButton.BorderBrush>
                                    <Binding Path="BorderBrush" RelativeSource="{RelativeSource TemplatedParent}"/>
                                </ToggleButton.BorderBrush>
                                <ToggleButton.BorderThickness>
                                    <Binding Path="BorderThickness" RelativeSource="{RelativeSource TemplatedParent}"/>
                                </ToggleButton.BorderThickness>
                            </ToggleButton>
                            <Path Data="M0,0 L5,5 L10,0 Z" Fill="{StaticResource TextMutedBrush}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource FieldBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,4,0,0" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- "New board" card: placed as the first item of BoardList (x:Shared=False so each refresh gets a fresh element) -->
        <Button x:Key="NewBoardCard" x:Shared="False" Width="252" Height="206" Margin="10" Cursor="Hand">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8" BorderThickness="2" BorderBrush="{StaticResource AccentBrush}" Background="{StaticResource ToolbarBrush}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="＋" FontSize="44" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="새 판서" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Window.Resources>

    <Grid>
    <DockPanel x:Name="BoardView" Background="#FF15161B">
        <!-- Top toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource ToolbarBorderBrush}" BorderThickness="0,0,0,1">
                <WrapPanel Orientation="Horizontal" Margin="12,9" VerticalAlignment="Center">

                    <Button x:Name="HomeButton" Content="🏠 홈" ToolTip="판서 목록으로 (현재 판서는 자동 저장됩니다)" Click="HomeButton_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button x:Name="NewButton" Content="📄 새 판서" Click="NewButton_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button x:Name="OpenButton" Content="📂 불러오기" Click="OpenButton_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button x:Name="SaveButton" Content="💾 저장" Click="SaveButton_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button x:Name="ExportPngButton" Content="🖼 PNG 내보내기" Click="ExportPngButton_Click" Style="{StaticResource ToolbarButtonStyle}"/>

                    <Border Style="{StaticResource SectionDivider}"/>

                    <Button x:Name="UndoButton" Content="↶" ToolTip="실행취소 (Ctrl+Z)" Click="UndoButton_Click" Style="{StaticResource IconButtonStyle}"/>
                    <Button x:Name="RedoButton" Content="↷" ToolTip="다시실행 (Ctrl+Y)" Click="RedoButton_Click" Style="{StaticResource IconButtonStyle}"/>

                    <Border Style="{StaticResource SectionDivider}"/>

                    <ToggleButton x:Name="PenToolButton" Content="🖊 펜" Click="PenToolButton_Click" Style="{StaticResource ToolToggleStyle}" IsChecked="True"/>
                    <ToggleButton x:Name="HighlighterToolButton" Content="🖍 형광펜" Click="HighlighterToolButton_Click" Style="{StaticResource ToolToggleStyle}"/>
                    <ToggleButton x:Name="EraserToolButton" Content="🧹 지우개" Click="EraserToolButton_Click" Style="{StaticResource ToolToggleStyle}"/>
                    <ToggleButton x:Name="TextToolButton" Content="🔤 텍스트" ToolTip="칠판을 클릭한 곳에 글자 입력 (Esc: 입력 마침)"
                                  Click="TextToolButton_Click" Style="{StaticResource ToolToggleStyle}"/>
                    <ToggleButton x:Name="SelectToolButton" Content="↕ 선택/이동" Click="SelectToolButton_Click" Style="{StaticResource ToolToggleStyle}"/>
                    <ToggleButton x:Name="PanToolButton" Content="✋ 화면이동" ToolTip="드래그로 칠판 이동 (스페이스바를 누른 채 드래그해도 됩니다)"
                                  Click="PanToolButton_Click" Style="{StaticResource ToolToggleStyle}"/>
                    <Button x:Name="ZoomResetButton" Content="100%" ToolTip="클릭하면 100%로 되돌립니다 (Ctrl+0)" MinWidth="52"
                            Click="ZoomResetButton_Click" Style="{StaticResource ToolbarButtonStyle}"/>

                    <Border Style="{StaticResource SectionDivider}"/>

                    <TextBlock x:Name="SizeLabel" Text="굵기" Style="{StaticResource GroupLabel}"/>
                    <Slider x:Name="ThicknessSlider" Width="100" Minimum="1" Maximum="30" Value="3"
                            ValueChanged="ThicknessSlider_ValueChanged" VerticalAlignment="Center"
                            Style="{StaticResource ToolbarSliderStyle}"/>
                    <TextBlock Text="{Binding Value, ElementName=ThicknessSlider, StringFormat={}{0:0}}"
                               Foreground="{StaticResource TextMutedBrush}" Width="20" Margin="6,0,0,0" VerticalAlignment="Center"/>

                    <Border Style="{StaticResource SectionDivider}"/>

                    <TextBlock Text="색상" Style="{StaticResource GroupLabel}"/>
                    <Button Style="{StaticResource ColorSwatchStyle}" Background="Black" Click="ColorSwatch_Click" Tag="#FF000000"/>
                    <Button Style="{StaticResource ColorSwatchStyle}" Background="#FFE5484D" Click="ColorSwatch_Click" Tag="#FFE5484D"/>
                    <Button Style="{StaticResource ColorSwatchStyle}" Background="#FF4C9AFF" Click="ColorSwatch_Click" Tag="#FF4C9AFF"/>
                    <Button Style="{StaticResource ColorSwatchStyle}" Background="#FF3DBE6C" Click="ColorSwatch_Click" Tag="#FF3DBE6C"/>
                    <Button Style="{StaticResource ColorSwatchStyle}" Background="#FFF5A623" Click="ColorSwatch_Click" Tag="#FFF5A623"/>
                    <Button Style="{StaticResource ColorSwatchStyle}" Background="#FFF7E24C" Click="ColorSwatch_Click" Tag="#FFF7E24C"/>
                    <Button Style="{StaticResource ColorSwatchStyle}" Background="White" Click="ColorSwatch_Click" Tag="#FFFFFFFF"/>
                    <Button x:Name="CustomColorButton" Content="🎨" ToolTip="사용자 지정 색상" Width="28" Height="26" Margin="6,0,0,0"
                            Click="CustomColorButton_Click" Style="{StaticResource ToolbarButtonStyle}"/>

                    <Border Style="{StaticResource SectionDivider}"/>

                    <Button x:Name="CaptureButton" Content="📷 화면 캡처" Click="CaptureButton_Click" Style="{StaticResource PrimaryButtonStyle}"/>

                    <Border Style="{StaticResource SectionDivider}"/>

                    <TextBlock Text="배경" Style="{StaticResource GroupLabel}"/>
                    <ComboBox x:Name="BackgroundCombo" SelectionChanged="BackgroundCombo_SelectionChanged" Style="{StaticResource ToolbarComboBoxStyle}">
                        <ComboBoxItem Content="흰색" Tag="White" IsSelected="True"/>
                        <ComboBoxItem Content="칠판(검정)" Tag="Blackboard"/>
                        <ComboBoxItem Content="칠판(초록)" Tag="GreenBoard"/>
                    </ComboBox>
                </WrapPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource ToolbarBorderBrush}" BorderThickness="0,1,0,0" Padding="14,7">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Text="준비됨 — Ctrl+V로 이미지/텍스트 붙여넣기, 📷 버튼으로 화면 캡처"/>
        </Border>

        <!-- Capture tray: screen captures wait here as thumbnails; click one to place it on the board -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource ToolbarBorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="14,4,8,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="🗂 폴더 열기" ToolTip="캡처 보관함 폴더를 탐색기로 엽니다" Click="TrayFolder_Click"
                                Style="{StaticResource ToolbarButtonStyle}" FontSize="12" Padding="8,3"/>
                        <Button x:Name="TrayToggleButton" Content="접기 ▾" Click="TrayToggle_Click"
                                Style="{StaticResource ToolbarButtonStyle}" FontSize="12" Padding="8,3"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TrayHeaderText" Text="📷 캡처 보관함" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5" FontWeight="SemiBold"/>
                        <TextBlock Text="· 썸네일을 클릭하면 칠판에 붙습니다" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="8,0,0,0"/>
                    </StackPanel>
                </DockPanel>

                <Grid x:Name="TrayBody" Height="104">
                    <TextBlock x:Name="TrayEmptyText" Foreground="{StaticResource TextMutedBrush}" FontSize="12.5"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="📷 화면 캡처 버튼으로 캡처한 그림이 여기에 모입니다. 언제든 클릭해서 칠판에 붙이세요."/>
                    <ScrollViewer x:Name="TrayScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="TrayScroll_PreviewMouseWheel">
                        <ItemsControl x:Name="CaptureTrayList" Margin="10,2,10,6">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="TrayItem_Click" Tag="{Binding}" ToolTip="{Binding ToolTipText}" Margin="4" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid>
                                                    <Border x:Name="Bd" Background="White" CornerRadius="4" Padding="3"
                                                            BorderThickness="2" BorderBrush="#FF3A3E48">
                                                        <Image Source="{Binding Thumbnail}" Height="78" MaxWidth="170" Stretch="Uniform"/>
                                                    </Border>
                                                    <Button x:Name="Del" Click="TrayDelete_Click" Tag="{Binding}" ToolTip="보관함에서 삭제 (휴지통으로 이동)"
                                                            Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Margin="0,-6,-6,0" Opacity="0.55" Cursor="Hand">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Grid>
                                                                    <Ellipse x:Name="DelBg" Fill="#FFE5484D"/>
                                                                    <TextBlock Text="✕" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="DelBg" Property="Fill" Value="#FFF25C61"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                        <Setter TargetName="Del" Property="Opacity" Value="1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Canvas area: the viewport onto a very large "world" that is panned/zoomed via WorldGrid's transform -->
        <Border x:Name="Viewport" Background="White" ClipToBounds="True"
                Focusable="True" FocusVisualStyle="{x:Null}"
                SizeChanged="Viewport_SizeChanged"
                PreviewMouseDown="Viewport_PreviewMouseDown"
                PreviewMouseMove="Viewport_PreviewMouseMove"
                PreviewMouseUp="Viewport_PreviewMouseUp"
                PreviewMouseWheel="Viewport_PreviewMouseWheel"
                LostMouseCapture="Viewport_LostMouseCapture">
            <Canvas>
                <Grid x:Name="WorldGrid" RenderTransformOrigin="0,0">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="WorldScale" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="WorldTranslate"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Canvas x:Name="ObjectCanvas" Background="Transparent" MouseLeftButtonDown="ObjectCanvas_MouseLeftButtonDown"/>
                    <InkCanvas x:Name="MainInkCanvas" Background="Transparent"/>
                </Grid>
            </Canvas>
        </Border>
    </DockPanel>

    <!-- Home screen: gallery of saved boards, like Microsoft Whiteboard's start page -->
    <DockPanel x:Name="HomeView" Background="#FF15161B">
        <Border DockPanel.Dock="Top" Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource ToolbarBorderBrush}" BorderThickness="0,0,0,1" Padding="28,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📂 파일에서 가져오기" Click="OpenButton_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="🗂 저장 폴더 열기" Click="OpenLibraryFolder_Click" Style="{StaticResource ToolbarButtonStyle}" Margin="4,0,0,0"/>
                </StackPanel>
                <TextBlock Text="내 판서" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="BoardList" Margin="20,20,20,28">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="BoardCard_Click" Tag="{Binding}" Width="252" Height="206" Margin="10" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="8" Background="White" BorderThickness="1" BorderBrush="#FF2E323C" ClipToBounds="True">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Border Background="#FFF4F5F7" CornerRadius="8,8,0,0">
                                                    <Grid>
                                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                                        <TextBlock Text="미리보기 없음" Foreground="#FF9AA0AC" FontSize="12"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                                <DockPanel Grid.Row="1" Margin="14,10,8,12">
                                                    <Button DockPanel.Dock="Right" Content="···" ToolTip="더 보기" Tag="{Binding}" Click="BoardMenu_Click"
                                                            VerticalAlignment="Center" Width="30" Height="28" Cursor="Hand">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="MBd" CornerRadius="4" Background="Transparent">
                                                                    <TextBlock Text="···" FontSize="16" FontWeight="Bold" Foreground="#FF333740" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="MBd" Property="Background" Value="#FFE6E8EC"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="#FF1B1D23" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding EditedText}" FontSize="12" Foreground="#FF5B606B" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
        </ScrollViewer>
    </DockPanel>
    </Grid>
</Window>
